# Cron runner image — used by the Railway cron services.
#
# Select it on a cron service with the service variable:
#   RAILWAY_DOCKERFILE_PATH=Dockerfile.cron
# (a variable, NOT config-as-code — Railway deprecated that, and services
# created after 2026-08-28 cannot opt into it at all).
#
# Deliberately NOT the app image: these services only make an authenticated HTTP
# call to the already-deployed web service, so building Next here would cost
# minutes of build time and a much larger image for no benefit. It also avoids
# needing the app's NEXT_PUBLIC_* build args on a service that never serves pages.
FROM node:22-alpine

WORKDIR /app
COPY scripts/run-cron.mjs ./scripts/run-cron.mjs
USER node

# Railway's per-service start command overrides this; the default is the job
# that runs most often.
CMD ["node", "scripts/run-cron.mjs", "reminders"]
